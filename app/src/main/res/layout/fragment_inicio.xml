<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView style="@style/SectionHeading" android:text="¿Cómo funciona?" android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="16dp">

            <include layout="@layout/item_how_it_works"
                android:id="@+id/how1" />
            <include layout="@layout/item_how_it_works"
                android:id="@+id/how2"
                android:layout_marginTop="12dp" />
            <include layout="@layout/item_how_it_works"
                android:id="@+id/how3"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/proximosContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/SectionHeading" android:text="⚠️ Próximos a caducar" android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/proximosList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
